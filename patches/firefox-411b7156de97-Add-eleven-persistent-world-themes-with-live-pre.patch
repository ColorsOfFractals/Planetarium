+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. */
+
+import React from "react";
+
+const bodies = [
+  { name: "YouTube", glyph: "Γû╢", orbit: 1, angle: 0 },
+  { name: "Wikipedia", glyph: "W", orbit: 1, angle: 90 },
+  { name: "Reddit", glyph: "ΓùÅ", orbit: 1, angle: 180 },
+  { name: "GitHub", glyph: "Γîÿ", orbit: 1, angle: 270 },
+  { name: "Music", glyph: "ΓÖ½", orbit: 2, angle: 45 },
+  { name: "Museum", glyph: "Γ£ª", orbit: 2, angle: 135 },
+  { name: "Mail", glyph: "Γ£ë", orbit: 2, angle: 225 },
+  { name: "Web", glyph: "Γê₧", orbit: 2, angle: 315 },
+];
+
+
+/* PLANETARIUM_FREEFORM_DRAG */
+
+const PLANETARIUM_POSITION_KEY = "planetarium.orb.positions.v1";
+
+function loadPlanetariumPositions() {
+  try {
+    return JSON.parse(
+      localStorage.getItem(PLANETARIUM_POSITION_KEY) || "{}"
+    );
+  } catch (_) {
+    return {};
+  }
+}
+
+function savePlanetariumPosition(name, x, y) {
+  try {
+    const saved = loadPlanetariumPositions();
+
+    saved[name] = { x, y };
+
+    localStorage.setItem(
+      PLANETARIUM_POSITION_KEY,
+      JSON.stringify(saved)
+    );
+  } catch (_) {}
+}
+
+function getPlanetariumPosition(body) {
+  const saved = loadPlanetariumPositions();
+  return saved[body.name] || null;
+}
+
+function beginPlanetariumFreeDrag(event, body) {
+  const system = event.currentTarget.closest(".planetarium-system");
+
+  if (
+    event.button !== 0 ||
+    !system ||
+    system.dataset.constellationMode !== "true"
+  ) {
+    return;
+  }
+
+  const planet = event.currentTarget;
+
+  const systemRect = system.getBoundingClientRect();
+  const planetRect = planet.getBoundingClientRect();
+
+  const startPointerX = event.clientX;
+  const startPointerY = event.clientY;
+
+  const startX =
+    planetRect.left -
+    systemRect.left +
+    planetRect.width / 2;
+
+  const startY =
+    planetRect.top -
+    systemRect.top +
+    planetRect.height / 2;
+
+  let moved = false;
+  let lastX = startX;
+  let lastY = startY;
+
+  const move = pointerEvent => {
+    const dx = pointerEvent.clientX - startPointerX;
+    const dy = pointerEvent.clientY - startPointerY;
+
+    if (Math.hypot(dx, dy) > 3) {
+      moved = true;
+      planet.dataset.planetariumDragged = "true";
+      planet.classList.add("planetarium-dragging");
+    }
+
+    if (!moved) {
+      return;
+    }
+
+    lastX = startX + dx;
+    lastY = startY + dy;
+
+    planet.style.left = `${lastX}px`;
+    planet.style.top = `${lastY}px`;
+    planet.style.transform = "translate(-50%, -50%)";
+  };
+
+  const finish = pointerEvent => {
+    if (moved) {
+      savePlanetariumPosition(
+        body.name,
+        lastX,
+        lastY
+      );
+
+      window.setTimeout(() => {
+        delete planet.dataset.planetariumDragged;
+      }, 0);
+    }
+
+    planet.classList.remove("planetarium-dragging");
+
+    try {
+      planet.releasePointerCapture(pointerEvent.pointerId);
+    } catch (_) {}
+
+    planet.removeEventListener("pointermove", move);
+    planet.removeEventListener("pointerup", finish);
+    planet.removeEventListener("pointercancel", finish);
+  };
+
+  try {
+    planet.setPointerCapture(event.pointerId);
+  } catch (_) {}
+
+  planet.addEventListener("pointermove", move);
+  planet.addEventListener("pointerup", finish);
+  planet.addEventListener("pointercancel", finish);
+}
+
+function suppressPlanetariumDragClick(event) {
+  if (
+    event.currentTarget.dataset.planetariumDragged === "true"
+  ) {
+    event.preventDefault();
+    event.stopPropagation();
+  }
+}
+
+
+/* PLANETARIUM_CONSTELLATION_MODE */
+
+const PLANETARIUM_EDIT_KEY = "planetarium.constellation.edit.v1";
+
+function loadPlanetariumEditMode() {
+  try {
+    return localStorage.getItem(PLANETARIUM_EDIT_KEY) === "true";
+  } catch (_) {
+    return false;
+  }
+}
+
+function savePlanetariumEditMode(enabled) {
+  try {
+    localStorage.setItem(
+      PLANETARIUM_EDIT_KEY,
+      enabled ? "true" : "false"
+    );
+  } catch (_) {}
+}
+
+export function Planetarium() {
+  const [constellationMode, setConstellationMode] =
+    React.useState(loadPlanetariumEditMode);
+
+  const toggleConstellationMode = () => {
+    setConstellationMode(current => {
+      const next = !current;
+      savePlanetariumEditMode(next);
+      return next;
+    });
+  };
+
+  return (
+    <section
+      className="planetarium-orbit"
+      aria-label="Planetarium"
+      data-constellation-mode={constellationMode ? "true" : "false"}
+    >
+      <div className="planetarium-stars" aria-hidden="true" />
+
+      <div
+          className="planetarium-system"
+          data-constellation-mode={constellationMode ? "true" : "false"}
+        >
+        <div className="planetarium-ring planetarium-ring-one" />
+        <div className="planetarium-ring planetarium-ring-two" />
+
+        <form
+          className="planetarium-core planetarium-core-search"
+          onSubmit={event => {
+            event.preventDefault();
+
+            const value =
+              event.currentTarget.elements.planetariumQuery.value.trim();
+
+            if (!value) {
+              return;
+            }
+
+            const hasScheme =
+              /^[a-zA-Z][a-zA-Z0-9+.-]*:\/\//.test(value);
+
+            const looksLikeDomain =
+              /^[^\s]+\.[^\s]+$/.test(value);
+
+            const looksLikeIP =
+              /^(?:\d{1,3}\.){3}\d{1,3}(?::\d+)?(?:\/.*)?$/.test(value);
+
+            const looksLikeLocalhost =
+              /^localhost(?::\d+)?(?:\/.*)?$/.test(value);
+
+            let destination;
+
+            if (hasScheme) {
+              destination = value;
+            } else if (
+              looksLikeDomain ||
+              looksLikeIP ||
+              looksLikeLocalhost
+            ) {
+              destination = `https://${value}`;
+            } else {
+              destination =
+                `https://www.google.com/search?q=${encodeURIComponent(value)}`;
+            }
+
+            window.location.assign(destination);
+          }}
+        >
+          <span className="planetarium-core-star" aria-hidden="true">
+            Γ£ª
+          </span>
+
+          <input
+            className="planetarium-core-input"
+            name="planetariumQuery"
+            type="text"
+            autoComplete="off"
+            spellCheck="false"
+            aria-label="Search or enter address"
+            placeholder="Search or enter address"
+          />
+        </form>
+
+        {bodies.map(body => (
+          <div
+            className={`planetarium-body planetarium-orbit-${body.orbit} planetarium-${body.name.toLowerCase()}`}
+            onPointerDown={event =>
+              beginPlanetariumFreeDrag(event, body)
+            }
+            onClickCapture={suppressPlanetariumDragClick}
+            style={(() => {
+              const position = getPlanetariumPosition(body);
+
+              if (position) {
+                return {
+                  left: `${position.x}px`,
+                  top: `${position.y}px`,
+                  transform: "translate(-50%, -50%)",
+                };
+              }
+
+              return {
+                "--planetarium-angle": `${body.angle}deg`,
+              };
+            })()}
+          >
+            <button className="planetarium-body-button" type="button">
+              <span className="planetarium-body-glyph">{body.glyph}</span>
+              <span className="planetarium-body-name">{body.name}</span>
+            </button>
+          </div>
+        ))}
+      </div>
+    
+        <button
+          type="button"
+          className="planetarium-constellation-toggle"
+          data-active={constellationMode ? "true" : "false"}
+          onClick={toggleConstellationMode}
+          aria-pressed={constellationMode}
+        >
+          <span className="planetarium-constellation-glyph">Γ£ª</span>
+          <span>
+            {constellationMode
+              ? "Lock Constellation"
+              : "Constellation Mode"}
+          </span>
+        </button>
+</section>
+  );
+}
