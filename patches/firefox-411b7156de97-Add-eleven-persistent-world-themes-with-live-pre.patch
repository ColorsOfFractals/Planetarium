+
+function loadPlanetariumTheme() {
+  try {
+    const stored = localStorage.getItem(PLANETARIUM_THEME_KEY);
+
+    if (
+      stored &&
+      PLANETARIUM_THEMES.some(theme => theme.id === stored)
+    ) {
+      return stored;
+    }
+  } catch (_) {}
+
+  return "neptune";
+}
+
+function savePlanetariumTheme(theme) {
+  try {
+    localStorage.setItem(
+      PLANETARIUM_THEME_KEY,
+      theme
+    );
+  } catch (_) {}
+}
+
 export function Planetarium() {
+  const [activeTheme, setActiveTheme] =
+    React.useState(loadPlanetariumTheme);
+
+  const [previewTheme, setPreviewTheme] =
+    React.useState(null);
+
+  const [themePickerOpen, setThemePickerOpen] =
+    React.useState(false);
+
+  const displayedTheme =
+    previewTheme || activeTheme;
+
+  const currentTheme =
+    PLANETARIUM_THEMES.find(
+      theme => theme.id === activeTheme
+    ) || PLANETARIUM_THEMES[8];
+
+  const choosePlanetariumTheme = theme => {
+    setActiveTheme(theme);
+    setPreviewTheme(null);
+    savePlanetariumTheme(theme);
+    setThemePickerOpen(false);
+  };
