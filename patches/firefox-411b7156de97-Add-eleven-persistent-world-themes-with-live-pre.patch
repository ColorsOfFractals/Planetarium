+  { id: "mercury",      name: "Mercury",       glyph: "Γÿ┐" },
+  { id: "venus",        name: "Venus",         glyph: "ΓÖÇ" },
+  { id: "earth",        name: "Earth",         glyph: "ΓùÅ" },
+  { id: "mars",         name: "Mars",          glyph: "ΓÖé" },
+  { id: "jupiter",      name: "Jupiter",       glyph: "ΓÖâ" },
+  { id: "saturn",       name: "Saturn",        glyph: "ΓÖä" },
+  { id: "uranus",       name: "Uranus",        glyph: "ΓÖà" },
+  { id: "neptune",      name: "Neptune",       glyph: "ΓÖå" },
+  { id: "pluto",        name: "Pluto",         glyph: "ΓÖç" },
