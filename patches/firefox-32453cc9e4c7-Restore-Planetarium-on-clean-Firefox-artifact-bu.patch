+  } catch (_) {
+    return {};
+  }
+}
+
+function savePlanetariumAngle(name, angle) {
+  try {
+    const saved = loadPlanetariumAngles();
+    saved[name] = angle;
+    localStorage.setItem(PLANETARIUM_ANGLE_KEY, JSON.stringify(saved));
+  } catch (_) {}
+}
+
+function getPlanetariumAngle(body) {
+  const saved = loadPlanetariumAngles();
+  const value = Number(saved[body.name]);
+
+  return Number.isFinite(value) ? value : body.angle;
+}
+
+function normalizePlanetariumAngle(angle) {
+  return (angle + 360) % 360;
+}
+
+function beginPlanetariumOrbitDrag(event, body) {
+  if (event.button !== 0) {
+    return;
+  }
+
+  const planet = event.currentTarget;
+  const system = planet.closest(".planetarium-system");
+
+  if (!system) {
+    return;
+  }
+
+  const rect = system.getBoundingClientRect();
+
+  const centerX = rect.left + rect.width / 2;
+  const centerY = rect.top + rect.height / 2;
+
+  const startX = event.clientX;
+  const startY = event.clientY;
+
+  let moved = false;
+  let lastAngle = getPlanetariumAngle(body);
+
+  const update = pointerEvent => {
+    const dx = pointerEvent.clientX - centerX;
+    const dy = pointerEvent.clientY - centerY;
+
+    const distanceMoved = Math.hypot(
+      pointerEvent.clientX - startX,
+      pointerEvent.clientY - startY
+    );
+
+    if (distanceMoved > 4) {
+      moved = true;
+      planet.dataset.planetariumDragged = "true";
+      planet.classList.add("planetarium-dragging");
+    }
+
+    if (!moved) {
+      return;
+    }
+
+    lastAngle = normalizePlanetariumAngle(
+      Math.atan2(dy, dx) * 180 / Math.PI
+    );
+
+    planet.style.setProperty(
+      "--planetarium-angle",
+      `${lastAngle}deg`
+    );
+  };
+
+  const finish = pointerEvent => {
+    if (moved) {
+      savePlanetariumAngle(body.name, lastAngle);
+
+      window.setTimeout(() => {
+        delete planet.dataset.planetariumDragged;
+      }, 0);
+    }
+
+    planet.classList.remove("planetarium-dragging");
+
+    try {
+      planet.releasePointerCapture(pointerEvent.pointerId);
+    } catch (_) {}
+
+    planet.removeEventListener("pointermove", update);
+    planet.removeEventListener("pointerup", finish);
+    planet.removeEventListener("pointercancel", finish);
+  };
+
+  try {
+    planet.setPointerCapture(event.pointerId);
+  } catch (_) {}
+
+  planet.addEventListener("pointermove", update);
+  planet.addEventListener("pointerup", finish);
+  planet.addEventListener("pointercancel", finish);
+}
+
+function suppressPlanetariumDragClick(event) {
+  const planet = event.currentTarget;
+
+  if (planet.dataset.planetariumDragged === "true") {
+    event.preventDefault();
+    event.stopPropagation();
+  }
+}
+
+
+export function Planetarium() {
+  return (
+    <section className="planetarium-orbit" aria-label="Planetarium">
+      <div className="planetarium-stars" aria-hidden="true" />
+
+      <div className="planetarium-system">
+        <div className="planetarium-ring planetarium-ring-one" />
+        <div className="planetarium-ring planetarium-ring-two" />
+
+        <form
+          className="planetarium-core planetarium-core-search"
+          onSubmit={event => {
+            event.preventDefault();
+
+            const value =
+              event.currentTarget.elements.planetariumQuery.value.trim();
+
+            if (!value) {
+              return;
+            }
+
+            const hasScheme =
+              /^[a-zA-Z][a-zA-Z0-9+.-]*:\/\//.test(value);
+
+            const looksLikeDomain =
+              /^[^\s]+\.[^\s]+$/.test(value);
+
+            const looksLikeIP =
+              /^(?:\d{1,3}\.){3}\d{1,3}(?::\d+)?(?:\/.*)?$/.test(value);
+
+            const looksLikeLocalhost =
+              /^localhost(?::\d+)?(?:\/.*)?$/.test(value);
+
+            let destination;
+
+            if (hasScheme) {
+              destination = value;
+            } else if (
+              looksLikeDomain ||
+              looksLikeIP ||
+              looksLikeLocalhost
+            ) {
+              destination = `https://${value}`;
+            } else {
+              destination =
+                `https://www.google.com/search?q=${encodeURIComponent(value)}`;
+            }
+
+            window.location.assign(destination);
+          }}
+        >
+          <span className="planetarium-core-star" aria-hidden="true">
+            Γ£ª
+          </span>
+
+          <input
+            className="planetarium-core-input"
+            name="planetariumQuery"
+            type="text"
+            autoComplete="off"
+            spellCheck="false"
+            aria-label="Search or enter address"
+            placeholder="Search or enter address"
+          />
+        </form>
+
+        {bodies.map(body => (
+          <div
+            className={`planetarium-body planetarium-orbit-${body.orbit} planetarium-${body.name.toLowerCase()}`}
+            onPointerDown={event =>
+              beginPlanetariumOrbitDrag(event, body)
+            }
+            onClickCapture={suppressPlanetariumDragClick}
+            key={body.name}
+            style={{ "--planetarium-angle": `${getPlanetariumAngle(body)}deg` }}
+          >
+            <button className="planetarium-body-button" type="button">
+              <span className="planetarium-body-glyph">{body.glyph}</span>
+              <span className="planetarium-body-name">{body.name}</span>
+            </button>
+          </div>
+        ))}
+      </div>
+    </section>
+  );
+}
