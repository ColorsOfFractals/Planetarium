diff --git a/browser/base/content/browser.js b/browser/base/content/browser.js
index f8bcc4a479c1..4396a7f97328 100644
--- a/browser/base/content/browser.js
+++ b/browser/base/content/browser.js
@@ -5605,3 +5605,245 @@ var FirefoxViewHandler = {
     );
   }
 })();
+
+
+/* ================================================================
+ * PLANETARIUM_NAV_ORB_V1
+ *
+ * Navigation machinery compressed into one orbital control.
+ *
+ * REST:
+ *      Γùë
+ *
+ * OPEN:
+ *   ΓåÉ  Γå╗  ΓåÆ
+ * ================================================================= */
+
+(() => {
+  "use strict";
+
+  const HTML_NS = "http://www.w3.org/1999/xhtml";
+
+  function make(tag, id, className = "") {
+    const el = document.createElementNS(HTML_NS, tag);
+
+    if (id) {
+      el.id = id;
+    }
+
+    if (className) {
+      el.className = className;
+    }
+
+    return el;
+  }
+
+  function initPlanetariumNavOrb() {
+    if (document.getElementById("planetarium-nav-orb")) {
+      return;
+    }
+
+    const transport =
+      document.getElementById("planetarium-transport-v3");
+
+    if (!transport) {
+      return;
+    }
+
+    const nav = make(
+      "div",
+      "planetarium-nav-orb"
+    );
+
+    nav.dataset.open = "false";
+
+    const lens = make(
+      "button",
+      "planetarium-nav-lens"
+    );
+
+    lens.type = "button";
+    lens.title = "Navigation";
+    lens.setAttribute(
+      "aria-label",
+      "Navigation controls"
+    );
+
+    const controls = make(
+      "div",
+      "planetarium-nav-controls"
+    );
+
+    const back = make(
+      "button",
+      "planetarium-nav-back",
+      "planetarium-nav-button"
+    );
+
+    back.type = "button";
+    back.textContent = "ΓåÉ";
+    back.title = "Back";
+
+    const reload = make(
+      "button",
+      "planetarium-nav-reload",
+      "planetarium-nav-button"
+    );
+
+    reload.type = "button";
+    reload.textContent = "Γå╗";
+    reload.title = "Reload";
+
+    const forward = make(
+      "button",
+      "planetarium-nav-forward",
+      "planetarium-nav-button"
+    );
+
+    forward.type = "button";
+    forward.textContent = "ΓåÆ";
+    forward.title = "Forward";
+
+    back.addEventListener("click", event => {
+      event.stopPropagation();
+
+      if (gBrowser?.selectedBrowser?.canGoBack) {
+        gBrowser.goBack();
+      }
+    });
+
+    reload.addEventListener("click", event => {
+      event.stopPropagation();
+
+      BrowserReload();
+    });
+
+    forward.addEventListener("click", event => {
+      event.stopPropagation();
+
+      if (gBrowser?.selectedBrowser?.canGoForward) {
+        gBrowser.goForward();
+      }
+    });
+
+    controls.append(
+      back,
+      reload,
+      forward
+    );
+
+    nav.append(
+      controls,
+      lens
+    );
+
+    document.documentElement.append(nav);
+
+    let closeTimer = null;
+
+    const setOpen = open => {
+      nav.dataset.open =
+        open ? "true" : "false";
+
+      lens.setAttribute(
+        "aria-expanded",
+        open ? "true" : "false"
+      );
+    };
+
+    const updateAvailability = () => {
+      const browser = gBrowser?.selectedBrowser;
+
+      if (!browser) {
+        return;
+      }
+
+      back.disabled = !browser.canGoBack;
+      forward.disabled = !browser.canGoForward;
+    };
+
+    const cancelClose = () => {
+      if (closeTimer) {
+        clearTimeout(closeTimer);
+        closeTimer = null;
+      }
+    };
+
+    const scheduleClose = () => {
+      cancelClose();
+
+      closeTimer = setTimeout(() => {
+        if (
+          !nav.matches(":hover") &&
+          !nav.contains(document.activeElement)
+        ) {
+          setOpen(false);
+        }
+      }, 500);
+    };
+
+    lens.addEventListener("click", event => {
+      setOpen(nav.dataset.open !== "true");
+      updateAvailability();
+      event.stopPropagation();
+    });
+
+    nav.addEventListener(
+      "mouseenter",
+      cancelClose
+    );
+
+    nav.addEventListener(
+      "mouseleave",
+      scheduleClose
+    );
+
+    nav.addEventListener(
+      "focusin",
+      cancelClose
+    );
+
+    nav.addEventListener(
+      "focusout",
+      scheduleClose
+    );
+
+    gBrowser?.tabContainer?.addEventListener(
+      "TabSelect",
+      updateAvailability
+    );
+
+    gBrowser?.addTabsProgressListener?.({
+      onLocationChange() {
+        updateAvailability();
+      }
+    });
+
+    window.addEventListener(
+      "keydown",
+      event => {
+        if (
+          event.key === "Escape" &&
+          nav.dataset.open === "true"
+        ) {
+          setOpen(false);
+          lens.focus();
+        }
+      }
+    );
+
+    updateAvailability();
+  }
+
+  if (document.readyState === "complete") {
+    initPlanetariumNavOrb();
+  }
+
+  if (document.readyState !== "complete") {
+    window.addEventListener(
+      "load",
+      initPlanetariumNavOrb,
+      { once: true }
+    );
+  }
+})();
